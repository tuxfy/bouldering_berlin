{
  "name": "bouldering-berlin-toolkit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Bouldering Berlin Toolkit — Sammlung kleiner, mobiler Tools rund ums Bouldern (PWA, ohne Build).",
  "scripts": {
    "ds:copy": "node scripts/ds-copy.mjs",
    "sw:build": "node scripts/gen-sw.mjs",
    "start": "npm run sw:build && node scripts/serve.mjs",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "check:ui": "stylelint \"app/**/*.css\" --config _anweisungen/pruefung/stylelint.json --ignore-path .stylelintignore",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "audit": "node scripts/audit.mjs",
    "check:secrets": "gitleaks detect --no-git --redact --no-banner --config gitleaks.toml",
    "test": "npm run lint && npm run format:check && npm run check:ui && npm run test:unit && npm run audit && npm run check:secrets && npm run test:e2e",
    "check:clean": "node scripts/check-clean.mjs"
  },
  "overrides": {
    "braces": ">=3.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "stylelint": "^16.26.1",
    "stylelint-declaration-strict-value": "^1.12.1",
    "vitest": "^4.1.12"
  }
}
